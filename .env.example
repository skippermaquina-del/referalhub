# Optional: enables real click tracking on /go/[slug] and the /admin/stats page.
# Create a free Redis database at https://console.upstash.com and paste the
# REST URL and token here. Without these, the site still works — clicks just
# won't be counted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for /admin/stats?key=... — pick any string.
ADMIN_KEY=

# Optional: your Google AI Studio (Gemini) API key, used by
# `npm run generate:posts` to write Instagram/Facebook captions for your offers.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: used by `npm run publish:instagram` to post directly to Instagram.
# See scripts/publish-instagram.cjs for how to generate these.
# IG_ACCESS_TOKEN is short-lived (~1hr) unless exchanged for a 60-day token.
IG_ACCESS_TOKEN=
IG_USER_ID=

# Allegiant Appliances (/allegiant). Where visit requests from the booking form
# are sent. Any webhook that accepts JSON works (Slack incoming webhook, Make,
# Zapier...). Without it, requests are only written to the server log.
ALLEGIANT_LEADS_WEBHOOK_URL=

# Google review links, once the Google Business profile is verified
# (Business Profile > "Ask for reviews" gives the short link).
NEXT_PUBLIC_ALLEGIANT_REVIEWS_URL=
NEXT_PUBLIC_ALLEGIANT_WRITE_REVIEW_URL=

# Public URL of the site (used for canonical and hreflang metadata).
NEXT_PUBLIC_SITE_URL=https://allegiantappliance.com
